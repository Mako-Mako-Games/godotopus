[configuration]
entry_symbol = "godotopus_init"
compatibility_minimum = "4.2"

[libraries]
windows.debug.x86_64 = "bin/libgodotopus.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/libgodotopus.windows.template_release.x86_64.dll"

linux.debug.x86_64 = "bin/libgodotopus.linux.template_debug.x86_64.so"
linux.release.x86_64 = "bin/libgodotopus.linux.template_release.x86_64.so"

macos.debug = "bin/libgodotopus.macos.template_debug.universal.dylib"
macos.release = "bin/libgodotopus.macos.template_release.universal.dylib"
